# OrderSuggest 設定範本
# 複製成 .env 後填入金鑰。.env 已在 .gitignore，不會被 commit 上去——
# 金鑰請用私訊傳，不要貼進 repo 或 issue。

# 伺服器
# 本機預設使用 127.0.0.1；若要讓同一個 Wi-Fi 的手機連線，再改成 0.0.0.0
HOST=127.0.0.1
PORT=7890
DEFAULT_RESTAURANT_NAME=預設餐廳
# 共用資料異動與付費模型操作使用；請用密碼管理器產生至少 32 bytes 隨機值。
ADMIN_API_KEY=
CORS_ORIGINS=http://127.0.0.1:7890,http://localhost:7890
TRUST_PROXY_HEADERS=false
SESSION_TTL_SECONDS=86400
DATABASE_PATH=data/ordersuggest.db
# v2 主要資料來源。正式環境必須使用 PostgreSQL；未設定時只供本機測試使用 SQLite。
DATABASE_URL=postgresql+psycopg://ordersuggest:ordersuggest@127.0.0.1:5432/ordersuggest
# 正式多 instance 部署時設定；未設定則 SQLite 仍可獨立運作。
REDIS_URL=
APP_ENV=development
SEMANTIC_RECOMMENDER_ENABLED=true
SEMANTIC_SHADOW_MODE=false

# Google 菜單爬蟲（只支援 Windows 本機／由本機提供的區網服務）
CRAWLER_ENABLED=true
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CRAWLER_CDP_PORT=9222
CRAWLER_MANUAL_ASSIST=false

# 公開評價搜尋：auto 會先用 Playwright 讀取 Google Maps 公開星等，
# 再補愛食記、Bing RSS、Google News RSS 與部落格文章。
# 若部署環境無法安裝瀏覽器，可改成 rss；舊 USE_PLAYWRIGHT_REVIEW_SEARCH 仍相容。
REVIEW_SEARCH_MODE=auto

# 學校的 OpenAI 相容 API
API_BASE_URL=https://api.ithu.tw/v1
API_KEY=
API_MODEL=vibe
VISION_MODEL=ornith-35b
VISION_VERIFY_MODEL=mistral-small-4
API_TEMPERATURE=0.7

# 特定子任務的模型，留空就用 API_MODEL
PREF_MODEL=
CLASSIFY_MODEL=

# 功能開關
# USE_LLM_EXTRACTION：用 LLM 理解偏好，每次多約 1.5 秒。關掉走關鍵字比對。
# USE_LLM_CLASSIFICATION：務必保持 false。程式碼裡的預設值是 true，
#   而它是「每個菜單品項各呼叫一次 LLM」，85 品項的菜單會讓單次對話慢到 57 秒。
USE_LLM_EXTRACTION=false
USE_LLM_CLASSIFICATION=false

# 只有在 API_BASE_URL 或 API_KEY 留空時才會用到的本機 Ollama 後備
OLLAMA_MODEL=gemma3:12b

# 設為 1 時跳過總覽與最終校對，辨識只跑並行的切塊 OCR（快很多，準確度略降）
VISION_FAST=
